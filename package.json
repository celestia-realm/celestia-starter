{
  "name": "celestia-starter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "docs": "turbo dev --filter=docs",
    "add-feature": "tsx packages/feature-manager/src/cli/index.ts add",
    "list-features": "tsx packages/feature-manager/src/cli/index.ts list"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.19.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
