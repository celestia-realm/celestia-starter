{
  "name": "auth",
  "version": "1.0.0",
  "description": "Email/password + OAuth authentication with Better Auth and Drizzle ORM",
  "dependencies": {
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "@types/pg": "^8.20.3"
  },
  "env": [
    "BETTER_AUTH_URL=http://localhost:3000",
    "BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>",
    "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celestia",
    "GOOGLE_CLIENT_ID=your-google-client-id",
    "GOOGLE_CLIENT_SECRET=your-google-client-secret"
  ],
  "requires": [],
  "files": {
    "lib/auth.ts": "lib/auth.ts",
    "lib/auth-client.ts": "lib/auth-client.ts",
    "lib/db.ts": "lib/db.ts",
    "app/api/auth/[...all]/route.ts": "app/api/auth/[...all]/route.ts"
  },
  "postInstall": [
    "pnpm --filter web exec drizzle-kit push"
  ],
  "notes": "After install, generate auth schema: pnpm --filter web exec @better-auth/cli generate --output db/auth-schema.ts"
}
