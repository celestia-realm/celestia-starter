{
  "name": "auth",
  "version": "2.0.0",
  "description": "Email/password + OAuth authentication with Better Auth — server in apps/api (Hono), client in apps/web (React)",
  "requires": [],
  "copies": [
    { "from": "api/src/auth.ts", "to": "apps/api/src/auth.ts" },
    { "from": "web/lib/auth-client.ts", "to": "apps/web/lib/auth-client.ts" }
  ],
  "dependencies": {
    "apps/api": {
      "better-auth": "^1.6.25",
      "drizzle-orm": "^0.45.2"
    },
    "apps/web": {
      "better-auth": "^1.6.25"
    }
  },
  "devDependencies": {
    "apps/api": {
      "drizzle-kit": "^0.31.10"
    }
  },
  "env": {
    "apps/api": [
      "BETTER_AUTH_URL=http://localhost:3000",
      "BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>",
      "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celestia",
      "GOOGLE_CLIENT_ID=your-google-client-id",
      "GOOGLE_CLIENT_SECRET=your-google-client-secret"
    ]
  },
  "postInstall": [
    "pnpm --filter @workspace/db db:push"
  ],
  "notes": "Auth server runs in apps/api (Hono). The web app proxies /api/auth/* to the backend. Frontend only imports the auth client (better-auth/react)."
}
